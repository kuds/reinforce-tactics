.DS_Store
/.idea
/.venv
/__pycache__
/videos
!docker/tournament/*.json
/reinforcetactics/ui/__pycache__
/reinforcetactics/utils/__pycache__
/reinforcetactics/game/__pycache__
/reinforcetactics/core/__pycache__
/reinforcetactics/__pycache__
/tests/__pycache__
*.pyc
**/__pycache__/

# Map editor temporary test scripts (not in tests/ directory)
/test_map_editor.py
/test_map_editor_components.py
/test_map_editor_save.py
/map_editor_demo.py
/replays
# Local saves are ignored, but the bundled demo scenarios stay tracked.
/saves/*
!/saves/*_scenario.json
settings.json

# Test/coverage artifacts
.coverage
htmlcov/
.pytest_cache/

# Build artifacts
*.egg-info/
dist/
build/

# RL training and evaluation artifacts.
# Loose tournament outputs are ignored, but versioned archive directories
# (e.g. tournament_results/0.1.1/) are deliberate per-release records and
# stay tracked.
/tournament_results/*
!/tournament_results/[0-9]*.[0-9]*.[0-9]*/
/checkpoints
/models
/tensorboard
/logs
# scripts/train/train_bootstrap.py's default run dir: model zips, per-stage
# checkpoints, videos and charts. The hand-written notes elsewhere under
# benchmarks/ stay tracked.
/benchmarks/bootstrap/

# Secrets: provider API keys in .env files and GCP credential JSON, anywhere
# in the tree (docker/tournament/.gitignore only covers its own directory).
.env
.env.*
!.env.example
*credentials*.json
*service-account*.json
# A service-account key as the Cloud Console names the download:
# <project-id>-<first 12 hex digits of the key id>.json.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# Transient scratch files from analysis/scan agents (Drive crawls,
# decoded payloads, working notes). Underscore-prefixed by convention;
# never deliverables.
/_*.py
/_*.md
/_*.json
/_*.txt

# uv resolves the pyproject into this lockfile whenever it is used to set up
# an environment. The project installs via pip (pyproject.toml +
# requirements.txt) and does not track a uv lockfile, so this is a local
# tooling artifact. Delete this entry if uv ever becomes the supported path.
/uv.lock
